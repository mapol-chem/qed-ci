include LICENSE README.md pyproject.toml setup.py
include tools/build_backend.py tools/check_docs.py
include src/ci_solver.c src/ci_solver.h src/orbital.c src/orbital.h src/qed_blas.h
include docs/README.md docs/installation.md docs/methods.md docs/development.md docs/configuration-and-output.md
recursive-include examples/quickstart *.py *.md
include tests/test_packaging.py
include tests/test_config.py tests/test_output.py tests/test_results.py tests/test_backend_build.py
recursive-include docs/audit *.md *.json
# Never ship environment-specific binaries, outputs, fixtures, or the separate C++ port.
global-exclude *.so *.dylib *.o *.pyc *.npz *.npy *.log *.dat .DS_Store SOURCES.txt
prune build
prune src/cpp_casscf
prune src/qed_ci/_native
prune src/qed_ci.egg-info
prune src/qed_ci/__pycache__
prune src/__pycache__
prune tests/__pycache__
prune src/tests/__pycache__
